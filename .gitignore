# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code internal directory
.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# committed browser-e2e stub env — FAKE values only (see e2e-browser/README.md)
!e2e-browser/.env.e2e

# playwright browser e2e artifacts
/e2e-browser/test-results/
/e2e-browser/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Throwaway probe scripts (agent runs)
_diagnostic*
.company-os/control.lock
