# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clerk authentication
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Redis (Upstash KV) — used for rate limiting
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your-kv-token

# Cron endpoint protection
CRON_SECRET=your-random-secret

# Tenant-scope guard (lib/supabase-guard.ts). TENANT_GUARD=1 observes and
# Sentry-logs any read of a tenant table with no spaceId/brokerageId filter.
# TENANT_GUARD_ENFORCE=1 additionally makes those queries THROW in production —
# a forgotten filter becomes a 500 for that request instead of a cross-tenant
# leak. Run in observe-only first, confirm the log is clean, then enforce.
TENANT_GUARD=1
TENANT_GUARD_ENFORCE=0

# Cloudflare background worker (worker/, docs/WORKER.md). This is the primary
# durable rail for recurring jobs, Work Sessions, and Voice-delegated work.
# WORKER_SECRET must be the SAME value in Vercel and the Cloudflare Worker.
# CRON_SECRET below must also match the Worker's CRON_SECRET. Without the pair,
# task offload falls back to Inngest only when both INNGEST_EVENT_KEY and
# INNGEST_SIGNING_KEY are configured, then to request-bound execution in bare
# previews. REDIS_URL is cache-only; scheduler heartbeat evidence uses
# KV_REST_API_URL + KV_REST_API_TOKEN above.
WORKER_URL=https://chippi-worker.your-account.workers.dev
WORKER_SECRET=your-random-worker-secret
REDIS_URL=rediss://default:password@your-redis-host:6379

# LLM providers.
#
# OPENAI_API_KEY — REQUIRED. The in-app chat agent (default runtime) runs on
#   OpenAI DIRECT with gpt-5-mini, so this key powers every interactive chat
#   turn. It is also the embeddings key and the OpenRouter fallback. Keep it set.
#
# OPENROUTER_API_KEY — when set, Chippi routes NON-agent model calls (autonomous
#   runs, lead-scoring, draft-writing, the legacy RAG route) through OpenRouter.
#   It does NOT affect the in-app chat agent, which always talks to OpenAI direct.
#   Must ALSO be in the Modal `chippi-secrets` secret for the Modal chat path
#   (CHIPPI_CHAT_RUNTIME=modal) and autonomous runs.
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# Optional model/runtime controls. TypeScript is the normal Fast mode runtime;
# `modal` routes the whole chat turn through MODAL_CHAT_URL below. Work Session
# and Workspace planning use the shared provider-aware model resolver: an
# OpenRouter model when that key is configured, otherwise an OpenAI fallback.
CHIPPI_CHAT_RUNTIME=ts
CHIPPI_CHAT_MODEL=
# Leave unset for adaptive fast-by-default reasoning. Set low only as an
# operator-level forced-fast override; medium/high are deliberate cost/latency
# overrides for every turn.
CHIPPI_REASONING_EFFORT=

# Chippi Live Workbench rollout. Keep false until the workbook migration,
# authenticated browser flow, and tenant-isolation checks have passed in
# staging. This flag controls both the panel and its server-side tool path.
NEXT_PUBLIC_CHIPPI_WORKBENCH_ENABLED=false

# Property "Analyze" web research (optional, but BOTH required for the feature).
#
# The Analyze action on a Property researches THAT specific address on the open
# web and uses the app LLM to structure the findings into the Property record.
#   TAVILY_API_KEY    — LLM-oriented web search (https://tavily.com). Finds the
#                       listing/sale-history/public-record pages for the address.
#   FIRECRAWL_API_KEY — page scraper (https://firecrawl.dev). Extracts beds,
#                       baths, sqft, year built, last-sold price, etc. from the
#                       Zillow/Redfin/Realtor.com/county pages Tavily surfaced.
#
# When EITHER key is missing the Analyze button returns a clear "research not
# configured" state — the app never crashes. The LLM contextualization itself
# reuses OPENAI_API_KEY / OPENROUTER_API_KEY above (no separate key).
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...

# ── Research Workspace / isolated browser (default off) ─────────────────────
# All three rollout controls must agree. A global flag alone never exposes the
# feature: list only explicit non-customer/canary Space IDs during staging.
CHIPPI_RESEARCH_WORKSPACE_ENABLED=false
NEXT_PUBLIC_CHIPPI_RESEARCH_WORKSPACE_ENABLED=false
CHIPPI_RESEARCH_WORKSPACE_SPACE_IDS=

# Dedicated browser-only Modal endpoint and shared bearer. The bearer must be
# the SAME value in Vercel and the narrow `chippi-browser-secrets` Modal secret.
MODAL_HEADLESS_BROWSER_URL=
CHIPPI_BROWSER_WORKER_SECRET=

# Modal-only browser secret/deploy inputs (do not add these to Vercel unless the
# Modal deployment itself runs there):
#   CHIPPI_BROWSER_APP_URL=https://your-preview-or-production-origin
#   CHIPPI_BROWSER_WORKER_SECRET=<same value as Vercel>
#   CHIPPI_BROWSER_VERCEL_BYPASS_SECRET=<optional protected-preview bypass>
#   CHIPPI_BROWSER_MODAL_APP_NAME=chippi-browser
#   CHIPPI_BROWSER_MODAL_SECRET_NAME=chippi-browser-secrets
#   CHIPPI_BROWSER_MODAL_BYPASS_SECRET_NAME=<optional separate secret name>

# Google Calendar integration (optional)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/tours/gcal/callback

# Resend (transactional email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Telnyx (SMS notifications)
TELNYX_API_KEY=KEY...
TELNYX_FROM_NUMBER=+15551234567

# Google Maps Static Images (optional — when set, the Chippi property card
# renders an inline map preview. Without it, the card shows an "Open in
# Maps" link only. Public key, safe to ship in the client.)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Wasabi S3-compatible object storage. One bucket; prefixes per feature
# (chat-attachments/, deal-documents/, contact-documents/, files/, etc.).
# Endpoint is region-specific — see https://wasabi.com/locations
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_BUCKET=
WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
WASABI_REGION=us-east-1
# Optional CDN / custom-domain base for public URLs. Defaults to
# {WASABI_ENDPOINT}/{WASABI_BUCKET}/{key}.
WASABI_PUBLIC_BASE_URL=

# ── Managed Workspace Runs + private terminal (default off) ─────────────────
# The base Workspace experience requires both flags and one explicit Space
# allowlist. It creates private packet files, so the five required Wasabi values
# above must also be configured before enabling it.
CHIPPI_WORKSPACE_RUNS_ENABLED=false
NEXT_PUBLIC_CHIPPI_WORKSPACE_RUNS_ENABLED=false
CHIPPI_WORKSPACE_RUNS_SPACE_IDS=

# Dedicated workspace-only Modal endpoint and two independent shared secrets.
# CHIPPI_WORKSPACE_MODAL_SECRET authenticates Vercel -> Modal launches.
# CHIPPI_WORKSPACE_CALLBACK_SECRET signs Modal -> Vercel claims/callbacks.
# Each value must match its counterpart in the narrow Modal secret; do not reuse
# WORKER_SECRET, AGENT_INTERNAL_SECRET, or the browser-worker secret.
MODAL_WORKSPACE_RUN_URL=
CHIPPI_WORKSPACE_MODAL_SECRET=
CHIPPI_WORKSPACE_CALLBACK_SECRET=

# Recovery is a separate server-only gate. Leave false until the migrations,
# callback routes, Cloudflare/Inngest durable rail, and a canary run are proven.
CHIPPI_WORKSPACE_RUN_RECOVERY_ENABLED=false

# Emergency Workspace Run recovery cron kill switch. Leave this UNSET during
# normal operation. Set the exact value `1` only to disable recovery; values
# such as `true`, `false`, or `0` are invalid and do not activate the switch.
# CRON_WORKSPACE_RUN_RECOVERY_DISABLED=1

# Emergency durable chat-turn lease recovery kill switch. Leave UNSET during
# normal operation. Set the exact value `1` only while deliberately pausing the
# five-minute recovery scanner; any other non-empty value is rejected.
# CRON_CONVERSATION_TURN_RECOVERY_DISABLED=1

# Follow-up/private-terminal work is narrower than base Workspace Runs and uses
# the same provider-aware model selection described above.
CHIPPI_WORKSPACE_RUN_FOLLOW_UPS_ENABLED=false
NEXT_PUBLIC_CHIPPI_WORKSPACE_RUN_FOLLOW_UPS_ENABLED=false
CHIPPI_WORKSPACE_RUN_FOLLOW_UPS_SPACE_IDS=
# Periodic recovery of committed follow-up tasks is independently default-off.
# Enable only after migration 00015 and the every-five-minute cron are proven.
CHIPPI_WORKSPACE_RUN_TASK_RECOVERY_ENABLED=false
MODAL_WORKSPACE_RUN_TASK_URL=

# Modal-only workspace secret/deploy inputs. Callback URLs must point at the
# same Vercel environment as MODAL_WORKSPACE_RUN_URL / *_TASK_URL:
#   CHIPPI_WORKSPACE_CALLBACK_URL=https://<app>/api/internal/workspace-runs/callback
#   CHIPPI_WORKSPACE_LAUNCH_CLAIM_URL=https://<app>/api/internal/workspace-runs/launch-claim
#   CHIPPI_WORKSPACE_TASK_CALLBACK_URL=https://<app>/api/internal/workspace-runs/tasks/callback
#   CHIPPI_WORKSPACE_TASK_LAUNCH_CLAIM_URL=https://<app>/api/internal/workspace-runs/tasks/launch-claim
#   CHIPPI_WORKSPACE_CALLBACK_SECRET=<same value as Vercel>
#   CHIPPI_WORKSPACE_MODAL_SECRET=<same value as Vercel>
#   CHIPPI_WORKSPACE_MODAL_APP_NAME=chippi-workspace
#   CHIPPI_WORKSPACE_MODAL_SECRET_NAME=chippi-workspace-secrets
#   CHIPPI_WORKSPACE_MODAL_BYPASS_SECRET_NAME=<optional separate bypass secret>
#   CHIPPI_WORKSPACE_MODAL_ENDPOINT_SECRET_NAME=<optional launch-secret bundle>

# fal.ai — image + video generation for Studio. The @fal-ai/client SDK reads
# FAL_KEY automatically. Required for Studio (also for the Modal agent's
# Studio tools, which call /api/internal/studio/generate in this app).
FAL_KEY=

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Legacy single price — used as Solo's fallback until the tier products exist.
STRIPE_PRICE_ID=price_...
# Plan tiers (lib/plans.ts is the source of truth for prices). Create the
# products in Stripe and paste the price IDs here. Solo $97 / Pro $197 bill the
# realtor's Space; Team $497 / Team Plus $897 bill the Brokerage.
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_SOLO_ANNUAL=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_TEAM_ANNUAL=price_...
STRIPE_PRICE_TEAM_PLUS=price_...
STRIPE_PRICE_TEAM_PLUS_ANNUAL=price_...
# Per-seat add-on prices for brokerage expansion above the included seats
# (Team +$79/seat, Team Plus +$69/seat). These MUST be PER-UNIT (licensed /
# quantity-billed) Stripe prices — the seat-billing code sets their line-item
# quantity to (active members − included seats). The base STRIPE_PRICE_TEAM /
# *_PLUS above are FLAT bundle prices (always quantity 1); do NOT reuse them
# here. Leave blank until the per-unit price objects exist; seats past the
# included count are then counted but not yet billed (a warning is logged).
STRIPE_PRICE_TEAM_ADDON=price_...
STRIPE_PRICE_TEAM_ADDON_ANNUAL=price_...
STRIPE_PRICE_TEAM_PLUS_ADDON=price_...
STRIPE_PRICE_TEAM_PLUS_ADDON_ANNUAL=price_...

# App URL
NEXT_PUBLIC_APP_URL=https://www.usechippi.com

# Public marketing-site root (used by app/robots.ts and app/sitemap.ts for
# canonical URLs). This is the bare apex domain; the app URL above uses www.
# Defaults to https://usechippi.com when unset.
NEXT_PUBLIC_SITE_URL=https://usechippi.com

# Phase D — auto-send for high-confidence drafts. When 'true', drafts with
# confidence >= 80 show a 30-second countdown that auto-fires the existing
# approve handler unless the realtor cancels. Default off; flip per-deploy.
NEXT_PUBLIC_AGENT_AUTO_SEND=false

# Chat runtime selector.
#   default (unset) → IN-APP TypeScript agent runtime. Runs in this Next.js
#     process on OpenAI-direct gpt-5-mini. No Modal cold start; first token is
#     fast. Full Chippi tool set, approval gates, rate limits, tool-call
#     logging, and the delegate_task orchestrator (which spawns deeper Modal
#     sub-agents for in-depth work and streams them inline).
#   CHIPPI_CHAT_RUNTIME=modal → route the WHOLE turn through the Modal sandbox
#     (MODAL_CHAT_URL). Reversible fallback for heavy turns or incident response.
# MODAL_CHAT_URL — the Modal chat_turn endpoint. Still required for: the
# CHIPPI_CHAT_RUNTIME=modal path AND attachment-bearing turns (the in-app TS
# runtime is text-only; photo/PDF turns auto-route to Modal when this is set).
# Get the URL from: modal deploy agent/modal_app.py (the chat_turn endpoint URL)
MODAL_CHAT_URL=https://<your-modal-org>--chippi-agent-chat-turn.modal.run

# Modal webhook for autonomous runs. Different endpoint from MODAL_CHAT_URL —
# this is the run_now_webhook function in agent/modal_app.py. Used by the
# /api/cron/agent-sweep job (every 4h), /api/agent/run-now (manual kick),
# and lib/agent/fire-trigger.ts (event-driven runs from CRM mutations).
# Without it, autonomous Chippi never runs; chat still works via MODAL_CHAT_URL.
# Get the URL from: modal deploy agent/modal_app.py (look for run_now_webhook).
MODAL_WEBHOOK_URL=https://<your-modal-org>--chippi-agent-run-now-webhook.modal.run

# Modal swarm endpoint. Used by /api/swarm for fan-out subagent runs AND by the
# chat agent's delegate_task tool (it spawns a swarm sub-agent run and streams
# progress inline in the chat thread). Set this for delegated deep tasks to work;
# without it, delegate_task reports it can't start and the agent answers directly.
MODAL_SWARM_URL=https://<your-modal-org>--chippi-agent-run-swarm.modal.run

# Which trigger events fire Modal immediately vs. wait for the 4h cron sweep.
# Comma-separated; valid values: new_lead, tour_completed, deal_stage_changed,
# application_submitted. Defaults to 'all' (every event fires Modal right away).
# Set to '' to disable immediate firing and rely entirely on the cron.
# AGENT_IMMEDIATE_EVENTS=all

# Shared secret between Next.js and Modal — must match the AGENT_INTERNAL_SECRET
# set in the chippi-secrets Modal secret. Used by both /api/agent/run-now and
# /api/ai/task to authorize cross-system calls.
AGENT_INTERNAL_SECRET=replace-with-a-long-random-string

# Signed, short-lived capability grants shared by the Vercel app and the main
# Modal `chippi-secrets` bundle. `shadow` preserves existing callers; change to
# `enforce` only after every trusted caller sends grants. Enforcement requires a
# distinct secret of at least 32 characters in BOTH systems.
AGENT_RUN_POLICY_MODE=shadow
AGENT_RUN_POLICY_SECRET=

# Reserved construction-only flag: no durable schedule-occurrence executor is
# wired, so setting `1` or `true` has no runtime effect and emits a boot warning.
# Keep false until selective claim with versioned input, atomic loop-state
# persistence, an audited unattended executor, opaque leases, and provider
# idempotency are independently accepted.
DURABLE_SCHEDULE_OCCURRENCES_ENABLED=false

# Emergency Work Session proposal kill switch. IMPORTANT: code treats EVERY
# non-empty value, including "false", as disabled. Leave this line commented to
# enable proposals; set exactly `1` only for an intentional rollback.
# Legacy WorkSession review/proposal execution is construction-only and always
# fail-closed. Work mode executes explicit actions in the conversation instead.
# WORK_SESSION_ACTIONS_DISABLED=1

# Composio — connects each realtor's Gmail/Slack/HubSpot/etc. so chat AND
# autonomous runs can act on their behalf through their own accounts.
# Without this, the integrations directory and inbox-connect surfaces are
# inert. Same key must be in chippi-secrets so the Modal agent can load
# the same toolkits.
COMPOSIO_API_KEY=ak_...

# RentCast — real comparables + valuation for the CMA engine (lib/rentcast.ts).
# Powers the "RentCast market data" path of /s/[slug]/cma: a subject address +
# beds/baths/sqft is sent to GET /avm/value, which returns an estimated price,
# a price range, and an array of nearby comparable sales. Get the key from the
# RentCast dashboard (https://app.rentcast.io/app/api). If unset, the CMA falls
# back to the workspace's own Property rows and labels the report "your CRM data"
# instead of "RentCast market data".
RENTCAST_API_KEY=

# Ably — real-time pub/sub that powers the LIVE activity feed (integration
# events stream to an open feed without polling). SERVER-ONLY: this is the
# private API key, never expose it as NEXT_PUBLIC — the browser only ever gets
# a short-lived, capability-scoped token minted by /api/ably/token. Get it from
# the Ably dashboard → your app → API Keys (a key with Publish + Subscribe).
# If unset, the live feed is disabled (the feed still works by loading from the
# database; only instant updates are off).
ABLY_API_KEY=

# Direct Postgres connection string for the Modal agent (asyncpg). Faster
# than the Supabase REST API for the bulk reads in agent/db.py. Get from
# Supabase project settings → Database → Connection string (URI).
# Used by the Modal side only; Next.js uses the Supabase JS client.
DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres

# ── Sentry (error tracking, tracing, logs) ───────────────────────────────────
# The Sentry↔Vercel integration injects SENTRY_AUTH_TOKEN automatically on
# Vercel. For the SDK to actually send events you must also set the DSN.
#
# Client + server DSN. Must be NEXT_PUBLIC_ so the browser SDK can read it.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# Optional: override the environment tag (defaults to VERCEL_ENV / NODE_ENV).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: trace sampling (0..1). Defaults to 0.1 in prod, 1.0 in dev.
SENTRY_TRACES_SAMPLE_RATE=
# Build-time sourcemap upload + the admin Observability view (server-side API
# reads). Org/project slugs and an auth token with project:read + project:releases.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── FirstPromoter affiliate program ─────────────────────────────────────────
# Server-side keys — never sent to the browser.
# FIRST_PROMOTER_API_KEY: found in FirstPromoter dashboard → Settings → API keys.
# FIRST_PROMOTER_ACCOUNT_ID: the numeric account id shown in the same settings page.
FIRST_PROMOTER_API_KEY=
FIRST_PROMOTER_ACCOUNT_ID=

# Public campaign id — shipped to the browser for fpr.js click tracking.
# Found in FirstPromoter dashboard → Campaigns → (your campaign) → Integration code.
# It is the "cid" parameter in the fpr("init", { cid: "..." }) snippet.
NEXT_PUBLIC_FIRST_PROMOTER_CID=

# Dashboard configuration (done in FirstPromoter, NOT in code):
#   1. Connect Stripe: FirstPromoter dashboard → Integrations → Stripe.
#      Match sales to promoters by billing email. This is how subscription revenue
#      is credited to affiliates automatically — no code change required.
#   2. Set commission structure: Campaigns → Edit → Commission. Pick recurring %
#      or one-time flat fee.
#   3. Payout methods: each affiliate configures their own payout (PayPal, Wise,
#      or Stripe) from the promoter dashboard (password_setup_url / dashboardUrl
#      returned by GET /api/affiliate). Chippi does not handle payouts directly.

# ── Marketing / advertising pixels ───────────────────────────────────────────
# All PUBLIC (they ship in client JS by design — none are secrets). Each channel
# loads + fires ONLY when its id is set, so leaving a line blank turns it off.
# The same signup / onboarding / purchase events fan out to every channel set.
#
# Meta (Facebook) Pixel — falls back to the committed Chippi id, so this var is
# only needed to OVERRIDE it. All others are off until set.
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 — "G-XXXXXXXXXX" (Admin → Data Streams → your web stream).
NEXT_PUBLIC_GA4_ID=
# Google Ads — conversion id "AW-XXXXXXXXX" + the conversion LABELS (the part
# after the slash in the tag's send_to) for the signup and purchase conversions.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Microsoft Clarity — project id (Clarity → Settings → Overview). Free heatmaps
# + session replay.
NEXT_PUBLIC_CLARITY_ID=
# LinkedIn Insight Tag — numeric Partner ID. Optional per-event Conversion IDs
# (Campaign Manager → Conversions) fire signup/purchase conversions.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_SIGNUP_CONVERSION_ID=
NEXT_PUBLIC_LINKEDIN_PURCHASE_CONVERSION_ID=
# TikTok / Pinterest / Reddit pixels — each platform's pixel/tag id.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
NEXT_PUBLIC_REDDIT_PIXEL_ID=
# Microsoft Bing UET — UET tag id (Microsoft Advertising → UET tag).
NEXT_PUBLIC_BING_UET_ID=

# ── Mailchimp (audience sync) ────────────────────────────────────────────────
# Server-side only. New signups are synced via the Clerk user.created webhook;
# existing users are backfilled with POST /api/admin/mailchimp/sync (admin-only).
# MAILCHIMP_API_KEY: Mailchimp → Account → Extras → API keys. The "-us21" suffix
#   is the datacenter and is parsed automatically (no separate host var needed).
# MAILCHIMP_AUDIENCE_ID: Audience → Settings → "Audience name and defaults".
#   Optional — auto-resolved when the account has exactly one audience; required
#   when there are several. GET /api/admin/mailchimp/sync lists the choices.
# NOTE: also enable the `user.created` event on the Clerk webhook for ongoing
#   sync of new signups (Clerk Dashboard → Webhooks → your endpoint → Events).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# ── Client portal (end-user applicant / tour-booker accounts) ────────────────
# Separate from realtor Clerk auth. Sessions are signed with this secret;
# falls back to CLERK_SECRET_KEY if unset, but set a dedicated one in prod.
CLIENT_AUTH_SECRET=
# Public base URL for the client portal (used in emails). If you point a
# subdomain at the /clients route tree, set it here e.g. https://clients.usechippi.com
NEXT_PUBLIC_CLIENTS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Additional vars read by the code but previously undocumented here. Set these
# on a new deployment or features silently degrade. All are optional at boot
# (see lib/env.ts); the ones flagged ⚠ boot green but break a feature in prod.
# ─────────────────────────────────────────────────────────────────────────────

# App domain / canonical URLs
# ⚠ The production app root (www.usechippi.com). Read by intake-link building
#   (lib/utils.ts), the MCP OAuth discovery docs, and the Stripe success-redirect
#   host check. Falls back to www.usechippi.com in prod SILENTLY — a wrong/empty
#   value points links at the wrong domain with no log.
NEXT_PUBLIC_ROOT_DOMAIN=www.usechippi.com
# Email-link origin for briefing emails (lib/briefing/delivery.ts). Set equal to
# NEXT_PUBLIC_APP_URL; otherwise it falls back to the Vercel preview URL.
NEXT_PUBLIC_APP_ORIGIN=https://www.usechippi.com

# Webhook signing secrets — verify each provider's callbacks. Get each from the
# provider dashboard for the PRODUCTION endpoint after registering its URL.
CLERK_WEBHOOK_SECRET=whsec_...        # Clerk dashboard → Webhooks
COMPOSIO_WEBHOOK_SECRET=whsec_...     # Composio dashboard → Webhooks
# Base64 public key from Telnyx Mission Control — verifies the Ed25519 signature
# on the voice webhook (app/api/webhooks/telnyx-voice). This is the primary gate.
# Without it, signature verification is skipped and the route falls back to the
# legacy shared-secret gate below.
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_SECRET=               # Telnyx → voice webhook (legacy ?secret= gate)

# Telnyx voice (inbound/outbound calling)
TELNYX_AGENT_NUMBER=+15551234567
TELNYX_VOICE_CONNECTION_ID=

# Token encryption + MCP JWT signing. Each falls back to CLERK_SECRET_KEY if
# unset; set DEDICATED secrets in prod so they can be rotated independently.
ENCRYPTION_KEY=
MCP_JWT_SECRET=

# Inngest (Studio scheduled posts + Composio trigger delivery, plus the durable
# fallback when the Cloudflare queue is unavailable). Both keys are required for
# the complete service. Cloudflare is the production recurring-job scheduler.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# NEVER enable INNGEST_CRONS_ENABLED while WORKER_URL + WORKER_SECRET are live.
# The app enforces exact `1` and refuses to register the mirror while the Worker
# pair is configured. For an intentional Cloudflare outage fallback, completely
# remove the Worker pair and then set: INNGEST_CRONS_ENABLED=1
# Optional emergency stop for registered Inngest cron mirrors:
INNGEST_CRONS_DISABLED=

# Briefing email "from" domain (must be verified in Resend). Defaults to
# alerts.usechippi.com.
BRIEF_EMAIL_DOMAIN=alerts.usechippi.com

# Web push (VAPID). Without these, push notifications are inert.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Sentry client-side trace sampling (0..1). The SERVER variant is
# SENTRY_TRACES_SAMPLE_RATE above; the browser SDK reads this NEXT_PUBLIC one.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Stripe top-up prices. Plan and brokerage-seat price IDs are documented once in
# the primary Stripe section above; do not duplicate them in this template.
STRIPE_PRICE_TOPUP_STARTER=price_...
STRIPE_PRICE_TOPUP_GROWTH=price_...
STRIPE_PRICE_TOPUP_POWER=price_...

# ─────────────────────────────────────────────────────────────────────────────
# Credit metering kill switch (lib/billing/meter.ts). Enforcement is ON by
# default — leave this UNSET in normal operation. Set CREDITS_ENFORCED=false ONLY
# as an emergency rollback: it disables the credit gate entirely (workflows run
# free, no account is blocked for a zero balance). Any value other than the exact
# string "false" (including unset) keeps enforcement ON.
# CREDITS_ENFORCED=false
# ── Realtime AI Voice (default off) ────────────────────────────────────────
# `1` is the only enabled value. OpenAI provides the Realtime WebRTC transport;
# delegated work continues on the primary Cloudflare Worker pair above, with
# both INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY accepted only as the legacy
# durable fallback. No browser credential is exposed.
REALTIME_VOICE_GATEWAY_ENABLED=0

# Conversation-bound specialist status/cancel tools are a second rollout gate.
# Keep false until Realtime Voice and its persisted specialist task state pass a
# canary. This expects the exact string `true` when enabled.
CHIPPI_REALTIME_VOICE_FLOOR_MANAGER_ENABLED=false
